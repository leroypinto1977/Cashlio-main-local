# Dependencies
node_modules

# Build outputs
dist
out
.dist
release

# Environment — never commit secrets
.env
.env.local
.env.*.local

# Prisma generated client (regenerated via postinstall)
/src/generated/prisma

# TypeScript build cache
*.tsbuildinfo

# Vite / electron-vite path alias artifacts
@/

# Editor & OS
.DS_Store
Thumbs.db
.eslintcache

# Logs
*.log
*.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.test-build/
resources/.env

.tls-build/
test/.build/
test/.build/

# The bundled PostgreSQL runtime — fetched per platform by
# scripts/fetch-postgres.sh, ~150 MB each, never committed.
resources/postgres/

# Microsoft's Visual C++ redistributable, fetched at build time by
# scripts/fetch-vc-redist.sh. Their binary, not ours to commit.
build/vc_redist.x64.exe
