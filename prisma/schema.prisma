generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ShopConfig {
  id               String   @id @default(uuid())
  shopName         String
  branchName       String
  licenseKey       String   @unique
  licenseJwt       String
  lastSyncedAt     DateTime @default(now())
  setupCompletedAt DateTime @default(now())

  // License hardening (Phase 4)
  hardwareId            String?   // The MAC bound to this license, snapshotted at activation
  licenseExpiresAt      DateTime? // Hard expiry from JWT claims
  lastSeenServerTime    DateTime? // Server-issued time floor; used to detect clock-tampering
  lastRefreshAt         DateTime? // Last successful /licenses/refresh
  lastRefreshAttempt    DateTime? // Last attempt regardless of outcome
  lastRefreshError      String?   // Last refresh failure reason (for the manager UI)
  licenseLocked         Boolean   @default(false) // True after grace period expires; blocks new bills
  gracePeriodDays       Int       @default(30)

  // Shop identity — printed on every tax invoice. `stateCode` is the 2-digit
  // GST state code (first two chars of the shop GSTIN) and decides whether a
  // sale is intra-state (CGST+SGST) or inter-state (IGST).
  gstin      String?
  stateCode  String?
  address    String?
  phone      String?
}

// Monotonic per-series counters for human-facing document numbers.
// Allocation is a single atomic INSERT ... ON CONFLICT DO UPDATE RETURNING, so
// concurrent bills can never receive the same number (the old count()-based
// scheme could, and did after a void).
model NumberSeries {
  series    String   // 'INV' (sale) | 'CN' (credit note) | 'BT' (batch)
  period    String   // 'YYMM' — series resets each calendar month (IST)
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([series, period])
}

model AuthorizedClient {
  id           String   @id @default(uuid())
  friendlyName String
  macAddress   String   @unique
  authorizedAt DateTime @default(now())
  // Short prefix (T1, T2, ...) handed to the terminal at pair time. Lets
  // terminals mint globally-unique bill numbers offline without server
  // coordination.
  terminalCode String?  @unique
  bills        Bill[]
}

// Append-only change log. Every write to an entity that terminals mirror
// (product, customer, bill, …) must insert one row here in the same tx.
// Terminals pull rows ordered by `id` and keep a cursor.
model SyncEvent {
  id        BigInt   @id @default(autoincrement())
  entity    String   // 'product' | 'customer' | 'bill'
  entityId  String
  op        String   // 'upsert' | 'delete'
  payload   Json?    // full row snapshot for upsert; null for delete
  createdAt DateTime @default(now())

  @@index([entity, id])
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("CASHIER")
  createdAt    DateTime @default(now())
  bills        Bill[]
  payments     Payment[]
  followUps    CustomerFollowUp[]
  purchaseOrders PurchaseOrder[]
}

model Warehouse {
  id        String         @id @default(uuid())
  name      String         @unique
  location  String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  batches   ProductBatch[]
}

/// Brand names are a controlled list rather than free text so that filtering
/// and brand-wise reporting stay reliable (no "Finolex" / "FINOLEX" drift).
model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Supplier {
  id            String            @id @default(uuid())
  name          String
  contactPerson String?
  phone         String
  email         String?
  address       String?
  gstin         String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  batches       ProductBatch[]
  products      ProductSupplier[]
  purchaseOrders PurchaseOrder[]
}

model ProductSupplier {
  id         String   @id @default(uuid())
  productId  String
  supplierId String
  isDefault  Boolean  @default(false)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
}

model Product {
  id                 String            @id @default(uuid())
  itemCode           String            @unique
  /// Denormalised copy of `brandRef.name`. `brandId` is authoritative; this is
  /// kept in step on rename so product search and the terminal sync payload
  /// don't need a join or a mirrored Brand table.
  brand              String?
  brandId            String?
  brandRef           Brand?            @relation(fields: [brandId], references: [id])
  name               String
  specification      String?
  categoryId         String
  productType        String?
  unitOfMeasure      String            @default("pcs")
  /// UNIT = sold in whole pieces. LENGTH = cut to size (pipe, wire, tube), so
  /// stock and bill quantities carry three decimal places.
  sellMode           String            @default("UNIT")
  gstPercentage      Decimal           @default(0) @db.Decimal(5, 2)
  warrantyPeriodDays Int               @default(0)
  minStockLevel      Decimal           @default(0) @db.Decimal(12, 3)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  sellingRate        Decimal           @default(0) @db.Decimal(10, 2)
  billItems          BillItem[]
  orderItems         PurchaseOrderItem[]
  category           Category          @relation(fields: [categoryId], references: [id])
  batches            ProductBatch[]
  suppliers          ProductSupplier[]
}

model ProductBatch {
  id              String     @id @default(uuid())
  productId       String
  batchCode       String
  uniqueStockCode String     @unique
  supplierId      String?
  /// Cost basis, ALWAYS excluding GST — margin and COGS are computed against
  /// the ex-GST cost so they compare like with like against taxable value.
  purchaseRate        Decimal @db.Decimal(10, 2)
  purchaseGstPct      Decimal @default(0) @db.Decimal(5, 2)
  purchaseGstAmount   Decimal @default(0) @db.Decimal(10, 2)
  /// Landed per-unit cost including tax. Derived, stored for display/reporting.
  purchaseRateInclGst Decimal @default(0) @db.Decimal(10, 2)
  warehouseId     String?
  receivedQty     Decimal    @default(0) @db.Decimal(12, 3)
  currentQty      Decimal    @default(0) @db.Decimal(12, 3)
  receivedDate    DateTime   @default(now())
  notes           String?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  product         Product    @relation(fields: [productId], references: [id])
  supplier        Supplier?  @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])
  allocations     BillItemBatch[]

  @@unique([productId, batchCode])
}

/// Which batch each sold unit actually came from.
///
/// Sales deduct oldest-first across batches, so without this a return has to
/// guess where to put the goods back — the old code always chose the newest
/// batch, which drifted batch quantities away from reality and made per-batch
/// cost meaningless. Recording the split makes returns and voids exact, and
/// gives true cost of goods instead of assuming the latest purchase rate.
model BillItemBatch {
  id         String       @id @default(uuid())
  billItemId String
  billItem   BillItem     @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  batchId    String
  batch      ProductBatch @relation(fields: [batchId], references: [id])
  quantity   Decimal      @db.Decimal(12, 3)
  /// Ex-GST cost of this batch at the moment of sale, so historic margin does
  /// not move when a batch is later re-rated.
  unitCost   Decimal      @default(0) @db.Decimal(10, 2)
  createdAt  DateTime     @default(now())

  @@index([billItemId])
  @@index([batchId])
}

// ─── Procurement ─────────────────────────────────────────────────────────────

/// A restock order placed with a supplier. Receiving one creates the batches,
/// which is why the goods-in form and the batch form ask the same questions.
model PurchaseOrder {
  id          String              @id @default(uuid())
  orderNumber String              @unique
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  /// DRAFT — still being built. PLACED — sent to the supplier. PARTIAL — some
  /// goods arrived. RECEIVED — complete. CANCELLED — abandoned.
  status      String              @default("DRAFT")
  expectedAt  DateTime?
  placedAt    DateTime?
  notes       String?
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       PurchaseOrderItem[]

  @@index([status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  orderedQty      Decimal       @db.Decimal(12, 3)
  receivedQty     Decimal       @default(0) @db.Decimal(12, 3)
  /// What the supplier quoted, excluding GST.
  expectedRate    Decimal       @default(0) @db.Decimal(10, 2)
  gstPercentage   Decimal       @default(0) @db.Decimal(5, 2)

  @@index([purchaseOrderId])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?
  address   String?
  gstin     String?
  isActive  Boolean  @default(true)
  /// Most a customer may owe at once. 0 means no credit is allowed at all.
  /// Outstanding is never stored — it is summed from unsettled bills, so it
  /// cannot drift out of step with them.
  creditLimit Decimal @default(0) @db.Decimal(10, 2)
  /// Days from bill date before the balance is considered due.
  creditDays  Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bills     Bill[]
  payments  Payment[]
  followUps CustomerFollowUp[]
}

/// A collection against a bill. Bills carry one row per tender taken at the
/// counter (so split payments are just several rows) plus one for every later
/// settlement. Money is never edited in place; it is only ever added here.
model Payment {
  id            String   @id @default(uuid())
  billId        String
  bill          Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  amount        Decimal  @db.Decimal(10, 2)
  method        String   // CASH | UPI | CARD | CHEQUE
  reference     String?  // UPI ref, cheque number, card approval code
  /// False for tender taken when the bill was raised, true for money collected
  /// afterwards. Voiding a bill that has real collections against it is refused.
  isSettlement  Boolean  @default(false)
  receivedAt    DateTime @default(now())
  collectedById String
  collectedBy   User     @relation(fields: [collectedById], references: [id])
  note          String?
  /// Idempotency key so a terminal replaying its outbox cannot double-post.
  clientLocalId String?  @unique
  createdAt     DateTime @default(now())

  @@index([customerId, receivedAt])
  @@index([billId])
}

/// A note to chase a customer, usually about an overdue balance.
model CustomerFollowUp {
  id          String    @id @default(uuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note        String
  dueAt       DateTime?
  resolvedAt  DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([customerId, resolvedAt])
}

model Bill {
  id             String           @id @default(uuid())
  billNumber     String           @unique
  clientLocalId  String?          @unique // idempotency key from billing client
  status         String           @default("PAID") // PAID | PARTIAL | CREDIT | VOID | RETURN
  customerId     String?
  originDeviceId String
  cashierId      String
  subtotal       Decimal          @db.Decimal(10, 2)
  gstAmount      Decimal          @db.Decimal(10, 2)
  discountAmount Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal          @db.Decimal(10, 2)
  // Tax-invoice breakdown. `taxableValue` is the ex-GST value of the sale
  // after both line and bill-level discounts; taxableValue + gstAmount ==
  // totalAmount. Exactly one of (cgst+sgst) or igst is non-zero.
  taxableValue   Decimal          @default(0) @db.Decimal(10, 2)
  cgstAmount     Decimal          @default(0) @db.Decimal(10, 2)
  sgstAmount     Decimal          @default(0) @db.Decimal(10, 2)
  igstAmount     Decimal          @default(0) @db.Decimal(10, 2)
  placeOfSupply  String?          // 2-digit GST state code of the customer
  /// Kept as the *primary* tender for display and for older clients. The full
  /// breakdown, including split payments, lives in `payments`.
  paymentMethod  String
  amountReceived Decimal?         @db.Decimal(10, 2)
  changeGiven    Decimal?         @db.Decimal(10, 2)
  /// Settlement. paidAmount + balanceDue == totalAmount at all times.
  paidAmount     Decimal          @default(0) @db.Decimal(10, 2)
  balanceDue     Decimal          @default(0) @db.Decimal(10, 2)
  /// billDate + the customer's credit days, set when a balance is carried.
  dueDate        DateTime?
  payments       Payment[]
  notes          String?
  paidAt         DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  // Return-bill fields: when status='RETURN', originalBillId points to the
  // PAID bill being refunded. Amounts on the return bill are stored as
  // positive values representing the refund amount.
  originalBillId String?
  originalBill   Bill?            @relation("BillReturns", fields: [originalBillId], references: [id])
  returns        Bill[]           @relation("BillReturns")
  returnReason   String?
  /// One of the shared RETURN_REASONS codes; `returnReason` keeps the note.
  returnReasonCode String?
  cashier        User             @relation(fields: [cashierId], references: [id])
  customer       Customer?        @relation(fields: [customerId], references: [id])
  originDevice   AuthorizedClient @relation(fields: [originDeviceId], references: [id])
  items          BillItem[]
}

model BillItem {
  id                 String     @id @default(uuid())
  billId             String
  productId          String
  itemCode           String
  productName        String
  unitOfMeasure      String
  quantity           Decimal    @db.Decimal(12, 3)
  unitRate           Decimal    @db.Decimal(10, 2)
  gstPercentage      Decimal    @db.Decimal(5, 2)
  lineDiscountPct    Decimal    @default(0) @db.Decimal(5, 2)
  lineDiscountAmt    Decimal    @default(0) @db.Decimal(10, 2)
  lineGstAmount      Decimal    @db.Decimal(10, 2)
  lineTotal          Decimal    @db.Decimal(10, 2)
  // Share of the bill-level discount apportioned to this line, and the
  // resulting ex-GST value. taxableValue + lineGstAmount == lineTotal -
  // billDiscountAmt, so the invoice foots exactly.
  billDiscountAmt    Decimal    @default(0) @db.Decimal(10, 2)
  taxableValue       Decimal    @default(0) @db.Decimal(10, 2)
  cgstAmount         Decimal    @default(0) @db.Decimal(10, 2)
  sgstAmount         Decimal    @default(0) @db.Decimal(10, 2)
  igstAmount         Decimal    @default(0) @db.Decimal(10, 2)
  createdAt          DateTime   @default(now())
  // For return-bill items: pointer to the original BillItem being refunded.
  // Lets us validate cumulative-returned-qty per original line without
  // ambiguity when the same product appears on multiple lines.
  originalBillItemId String?
  originalBillItem   BillItem?  @relation("BillItemReturns", fields: [originalBillItemId], references: [id])
  returnedAs         BillItem[] @relation("BillItemReturns")
  batchAllocations   BillItemBatch[]
  bill               Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  product            Product    @relation(fields: [productId], references: [id])
}
