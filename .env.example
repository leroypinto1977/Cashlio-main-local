# Local PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shopms_local?schema=public"

# Port the embedded Express API server will listen on
LOCAL_SERVER_PORT=52001

# Base URL of the Admin SaaS (App A) — no trailing slash
SAAS_API_URL=https://your-admin-saas-domain.com

# Signs cashier session tokens on this machine only. Does NOT need to match
# anything in admin-saas — license JWTs use the Ed25519 pair below instead.
JWT_SECRET=replace_with_a_long_random_string

# Exposed to the Vite renderer process (VITE_ prefix required)
# Must point to the same host/port as LOCAL_SERVER_PORT
VITE_LOCAL_API_URL=http://127.0.0.1:52001

# Ed25519 public key that verifies license JWTs from admin-saas (base64 SPKI
# DER). Safe to ship inside the binary. Comes from the same keypair as the
# server's LICENSE_PRIVATE_KEY — see admin-saas/scripts/gen-license-keys.js
LICENSE_PUBLIC_KEY=
